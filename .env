PORT=7000

# Bu addon'un dışarıdan erişilebilen adresi.
# Stremio'ya verilen altyazı indirme linkleri bu adresten üretilir. (zorunlu)
HOST_URL=""

# Doğrudan kazınacak kaynak site.
SITE_URL="https://turkcealtyazi.org"

# Anti-bot korumasını (Cloudflare / Yoncu) çözen FlareSolverr servisinin adresi.
# docker-compose ile birlikte çalıştırınca: http://flaresolverr:8191/v1
FLARESOLVERR_URL="http://flaresolverr:8191/v1"

# (İsteğe bağlı) Arama endpoint yolu. Boş bırakılırsa /ajax/things_.php ve
# /things_.php sırayla denenir.
SEARCH_PATH=""

# (İsteğe bağlı) Çözülen anti-bot cookie'sinin yeniden kullanım süresi (ms).
CLEARANCE_TTL_MS=1500000

# (İsteğe bağlı) FlareSolverr'ın bir challenge'ı çözmesi için tanınan süre (ms).
FLARESOLVERR_TIMEOUT_MS=60000
